APP_NAME=Automated Multi-Platform Posting System
ENVIRONMENT=development
HOST=0.0.0.0
PORT=4000
TARGET_PLATFORMS=["linkedin","facebook","instagram","tiktok","youtube","telegram","discord","bluesky","mastodon","slack"]
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
TELEGRAM_CHAT_ID=@your_public_channel
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
BLUESKY_HANDLE=your-handle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
MASTODON_BASE_URL=https://mastodon.example
MASTODON_ACCESS_TOKEN=replace-with-your-mastodon-access-token
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your-team-id/your-channel-id/your-webhook-token

